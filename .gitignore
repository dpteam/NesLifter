# =============================================================================
#  NesLifter - .gitignore
#  .NET build output, IDE state, generated games and local ROM dumps.
# =============================================================================

# ------------------------------- .NET / MSBuild ------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/
.artifacts/
*.binlog
*.tlog
*.obj
*.pdb
*.ilk
*.ipdb
*.iobj
*.pgc
*.pgd
*.sbr
*.rsp
!Directory.Build.rsp
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# ------------------------------- IDE / editors -------------------------------
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
Properties/launchSettings.json
*.suo
*.user
*.rsuser
*.userosscache
*.userprefs
*.sln.docstates
*.DotSettings.user
_ReSharper*/
*.GhostDoc.xml
*.tsbuildinfo
.history/
.vshistory/
**/.localhistory/
**/.cr/personal
*.tmp
*.tmp_proj
*_wpftmp.csproj
~$*
*~
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------- Test / coverage -----------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

# ------------------------------- NesLifter output ----------------------------
# Everything the lifter writes at runtime lives in the output folder.
nes_lifted_output/
out/
lifted/
**/src/Game.generated.cs
**/dynamic_targets.log
**/runtime.log
**/trap.log
**/analysis.txt
**/*.runtimeconfig.json
**/*.deps.json
**/*.icon.ico
**/_pkg/

# Publish profiles and local configuration
*.publishsettings
*.pubxml
*.pubxml.user
*.publishproj
PublishScripts/
publish/
dist/
*.env
.env.*
!.env.example

# ------------------------------- ROM images ----------------------------------
# Never commit commercial ROM dumps. Test ROMs are generated by --selftest.
*.nes
*.unf
*.unif
*.fds
*.nsf
*.gb
*.gbc
*.gba
*.smc
*.sfc

# Keep documentation assets and explicitly shared test data.
!docs/**/*.md
!docs/**/*.svg
!docs/**/*.png

# The GUI vendors NES.css and Font Awesome under web/vendor so it works
# offline. Those must be committed; nothing is fetched at runtime.
!web/vendor/**

# ------------------------------- OS / tools ----------------------------------
.vsconfig
*.cab
*.msi
*.msix
*.msm
*.msp
*.pfx
*.snk
